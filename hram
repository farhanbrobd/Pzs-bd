    <!-- App Logic Engine -->
    <script>
        let applicants = [];
        let examConfigs = {
            '৩য়': 'আসন: ১০০ টি | পরীক্ষা: ১৮ ডিসেম্বর ২০২৬, সকাল ১০টা',
            '৬ষ্ঠ': 'আসন: ১২০ টি | পরীক্ষা: ১৯ ডিসেম্বর ২০২৬, সকাল ১০টা',
            '৯ম': 'আসন: ১৫০ টি | পরীক্ষা: ২০ ডিসেম্বর ২০২৬, সকাল ১০টা'
        };
        let adminAuth = { user: 'admin', pass: 'panipur2026' };
        let committeeList = [];
        let siteLogo = '';
        let siteSignature = '';

        window.initializeAppCloud = async function() {
            lucide.createIcons();
            await loadCloudData();
        };

        async function loadCloudData() {
            try {
                if(!window.db) return;
                const { collection, getDocs, doc, getDoc } = window.dbMethods;
                
                // Load Applicants
                const querySnapshot = await getDocs(collection(window.db, "applicants"));
                applicants = [];
                querySnapshot.forEach((docSnap) => {
                    applicants.push({ id: docSnap.id, ...docSnap.data() });
                });

                // Load Settings (Configs, Committee, Branding, Admin Auth)
                const settingsDoc = await getDoc(doc(window.db, "settings", "school_config"));
                if(settingsDoc.exists()) {
                    const data = settingsDoc.data();
                    if(data.examConfigs) examConfigs = data.examConfigs;
                    if(data.committeeList) committeeList = data.committeeList;
                    if(data.adminAuth) adminAuth = data.adminAuth;
                    if(data.siteLogo) siteLogo = data.siteLogo;
                    if(data.siteSignature) siteSignature = data.siteSignature;
                }

                renderNoticeConfigs();
                renderCommittee();
                loadBranding();
                if(document.getElementById('admin-dashboard') && !document.getElementById('admin-dashboard').classList.contains('hidden')) {
                    loadAdminData();
                }
            } catch (err) {
                console.error("Cloud load error: ", err);
            }
        }

        async function saveSettingsToCloud() {
            try {
                const { doc, setDoc } = window.dbMethods;
                await setDoc(doc(window.db, "settings", "school_config"), {
                    examConfigs, committeeList, adminAuth, siteLogo, siteSignature
                });
            } catch (err) {
                console.error("Settings save error:", err);
            }
        }

        window.onload = function() {
            setTimeout(() => {
                if(window.db && window.initializeAppCloud) {
                    window.initializeAppCloud();
                }
            }, 500);
        };

        function switchTab(tabName) {
            ['notice', 'apply', 'payment', 'admit', 'admin'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                const btn = document.getElementById(`nav-${t}`);
                if(btn) { btn.classList.remove('bg-yellow-500', 'text-emerald-950'); btn.classList.add('bg-emerald-800'); }
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`nav-${tabName}`);
            if(activeBtn) { activeBtn.classList.add('bg-yellow-500', 'text-emerald-950'); activeBtn.classList.remove('bg-emerald-800'); }
        }

        function switchAdminTab(atab) {
            ['overview', 'applicants', 'committee', 'settings'].forEach(t => {
                document.getElementById(`atab-${t}`).classList.add('hidden');
                document.getElementById(`atab-btn-${t}`).classList.remove('bg-emerald-800', 'text-white');
                document.getElementById(`atab-btn-${t}`).classList.add('bg-gray-100', 'text-gray-700');
            });
            document.getElementById(`atab-${atab}`).classList.remove('hidden');
            document.getElementById(`atab-btn-${atab}`).classList.remove('bg-gray-100', 'text-gray-700');
            document.getElementById(`atab-btn-${atab}`).classList.add('bg-emerald-800', 'text-white');
        }

        function toggleGroupSelection() {
            const cls = document.querySelector('input[name="targetClass"]:checked')?.value;
            document.getElementById('group-selection').classList.toggle('hidden', cls !== '৯ম');
        }

        async function handleFormSubmit(e) {
            e.preventDefault();
            const targetClass = document.querySelector('input[name="targetClass"]:checked').value;
            const group = targetClass === '৯ম' ? (document.querySelector('input[name="studentGroup"]:checked')?.value || 'সাধারণ') : 'N/A';
            const newRoll = targetClass.charAt(0) + Math.floor(1000 + Math.random() * 9000);

            const fileInput = document.getElementById('studentPhoto');
            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = async function(event) {
                    await saveApplicantToCloud(newRoll, targetClass, group, event.target.result);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                await saveApplicantToCloud(newRoll, targetClass, group, '');
            }
        }

        async function saveApplicantToCloud(newRoll, targetClass, group, photoBase64) {
            const applicantData = {
                roll: newRoll, targetClass, group,
                name: document.getElementById('studentName').value,
                birthRegNo: document.getElementById('birthRegNo').value,
                dob: document.getElementById('dob').value,
                gender: document.getElementById('gender').value,
                religion: document.getElementById('religion').value,
                fatherName: document.getElementById('fatherName').value,
                fatherPhone: document.getElementById('fatherPhone').value,
                fatherNid: document.getElementById('fatherNid').value,
                fatherOccupation: document.getElementById('fatherOccupation').value,
                motherName: document.getElementById('motherName').value,
                motherNid: document.getElementById('motherNid').value || 'N/A',
                presentAddress: document.getElementById('presentAddress').value,
                prevSchool: document.getElementById('prevSchool').value,
                prevResult: document.getElementById('prevResult').value,
                quota: document.getElementById('quota').value,
                photo: photoBase64,
                paymentStatus: 'Pending', trxId: ''
            };

            try {
                const { collection, addDoc } = window.dbMethods;
                await addDoc(collection(window.db, "applicants"), applicantData);
                await loadCloudData();
                alert(`তথ্য সফলভাবে ক্লাউডে সংরক্ষিত হয়েছে!\nরোল: ${newRoll}\nএখন পেমেন্ট সম্পন্ন করুন।`);
                
                document.getElementById('admission-form').reset();
                switchTab('payment');
                document.getElementById('pay-identifier').value = newRoll;
            } catch (err) {
                alert('ডাটা সেভ করতে সমস্যা হয়েছে: ' + err.message);
            }
        }

        async function handlePaymentSubmit(e) {
            e.preventDefault();
            const identifier = document.getElementById('pay-identifier').value.trim();
            const trxId = document.getElementById('pay-trxid').value.trim();

            const user = applicants.find(a => a.roll === identifier || a.fatherPhone === identifier);
            if(user) {
                try {
                    const { doc, setDoc } = window.dbMethods;
                    user.paymentStatus = 'Paid';
                    user.trxId = trxId;
                    await setDoc(doc(window.db, "applicants", user.id), user);
                    await loadCloudData();
                    alert('পেমেন্ট সফল হয়েছে! এডমিট কার্ড ডাউনলোড করুন।');
                    switchTab('admit');
                    document.getElementById('searchRoll').value = user.roll;
                    searchAdmitCard();
                } catch(err) {
                    alert('পেমেন্ট আপডেট ব্যর্থ হয়েছে!');
                }
            } else {
                alert('কোনো আবেদন তথ্য পাওয়া যায়নি!');
            }
        }

        function searchAdmitCard() {
            const query = document.getElementById('searchRoll').value.trim();
            const result = applicants.find(a => (a.roll === query || a.fatherPhone === query) && a.paymentStatus === 'Paid');

            if(result) {
                document.getElementById('ac-roll').innerText = result.roll;
                document.getElementById('ac-class').innerText = result.targetClass;
                document.getElementById('ac-group').innerText = result.group !== 'N/A' ? `(${result.group})` : '';
                document.getElementById('ac-name').innerText = result.name;
                document.getElementById('ac-father').innerText = result.fatherName;
                document.getElementById('ac-mobile').innerText = result.fatherPhone;
                document.getElementById('ac-exam-info').innerText = examConfigs[result.targetClass] || 'শীঘ্রই জানানো হবে';
                document.getElementById('admit-card-container').classList.remove('hidden');
            } else {
                alert('পেমেন্ট সম্পন্ন হয়নি অথবা সঠিক তথ্য পাওয়া যায়নি!');
                document.getElementById('admit-card-container').classList.add('hidden');
            }
        }

        function viewStudentDetails(index) {
            const student = applicants[index];
            const detailsWindow = window.open('', '_blank', 'width=650,height=750');
            detailsWindow.document.write(`
                <html lang="bn"><head><title>বিস্তারিত - ${student.name}</title>
                <script src="https://cdn.tailwindcss.com"></script></head>
                <body class="p-6 bg-gray-50 font-sans">
                    <div class="max-w-md mx-auto bg-white p-6 rounded-xl shadow-lg border">
                        <div class="text-center mb-4">
                            <img src="${student.photo || 'https://via.placeholder.com/100'}" class="w-24 h-24 mx-auto object-cover rounded-full border-2 border-emerald-800 mb-2">
                            <h2 class="text-xl font-bold text-emerald-900">${student.name}</h2>
                            <p class="text-sm text-gray-600">রোল: <strong>${student.roll}</strong> | শ্রেণি: <strong>${student.targetClass} ${student.group !== 'N/A' ? '('+student.group+')' : ''}</strong></p>
                        </div>
                        <div class="space-y-2 text-sm border-t pt-4">
                            <p><strong>জন্ম নিবন্ধন:</strong> ${student.birthRegNo}</p>
                            <p><strong>জন্ম তারিখ:</strong> ${student.dob}</p>
                            <p><strong>ধর্ম ও লিঙ্গ:</strong> ${student.religion} (${student.gender})</p>
                            <p><strong>পিতার নাম:</strong> ${student.fatherName}</p>
                            <p><strong>পিতার এনআইডি:</strong> ${student.fatherNid}</p>
                            <p><strong>পিতার মোবাইল:</strong> ${student.fatherPhone}</p>
                            <p><strong>মাতার নাম:</strong> ${student.motherName} (NID: ${student.motherNid})</p>
                            <p><strong>কোটা:</strong> ${student.quota}</p>
                            <p><strong>বর্তমান ঠিকানা:</strong> ${student.presentAddress}</p>
                            <p><strong>পূর্ববর্তী স্কুল:</strong> ${student.prevSchool} (${student.prevResult})</p>
                            <p><strong>পেমেন্ট:</strong> <span class="text-green-600 font-bold">${student.paymentStatus} (TrxID: ${student.trxId || 'N/A'})</span></p>
                        </div>
                        <div class="mt-6 text-center"><button onclick="window.print()" class="bg-emerald-800 text-white px-4 py-2 rounded-xl text-sm">প্রিন্ট করুন</button></div>
                    </div>
                </body></html>
            `);
        }

        function showForgotPassword() {
            document.getElementById('forgot-password-box').classList.toggle('hidden');
        }

        async function recoverPassword() {
            const pin = document.getElementById('recovery-input').value.trim();
            if(pin === 'panipur2026' || pin === 'admin123') {
                adminAuth.user = 'admin'; adminAuth.pass = 'admin123';
                await saveSettingsToCloud();
                alert('পাসওয়ার্ড রিসেট হয়ে গেছে! নতুন ইউজার আইডি: admin, পাসওয়ার্ড: admin123');
                document.getElementById('forgot-password-box').classList.add('hidden');
            } else { alert('ভুল সিক্রেট পিন!'); }
        }

        function renderNoticeConfigs() {
            document.getElementById('display-configs-container').innerHTML = Object.keys(examConfigs).map(cls => `
                <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-200">
                    <h4 class="font-bold text-emerald-900 mb-1">${cls} শ্রেণি</h4>
                    <p class="text-xs text-gray-700">${examConfigs[cls]}</p>
                </div>
            `).join('');
        }

        function renderCommittee() {
            const container = document.getElementById('committee-cards-container');
            if(committeeList.length === 0) { container.innerHTML = '<p class="text-sm text-gray-500">কোনো তথ্য নেই।</p>'; return; }
            container.innerHTML = committeeList.map(c => `
                <div class="bg-gray-50 p-3 rounded-xl border text-center">
                    <p class="font-bold text-emerald-900">${c.name}</p>
                    <p class="text-xs text-gray-600">${c.designation}</p>
                    <p class="text-xs text-emerald-700 font-bold mt-1">📞 ${c.phone}</p>
                </div>
            `).join('');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            if(document.getElementById('adminUser').value === adminAuth.user && document.getElementById('adminPass').value === adminAuth.pass) {
                document.getElementById('admin-login-box').classList.add('hidden');
                document.getElementById('admin-dashboard').classList.remove('hidden');
                loadAdminData();
            } else { alert('ভুল পাসওয়ার্ড বা আইডি!'); }
        }

        function adminLogout() {
            document.getElementById('admin-dashboard').classList.add('hidden');
            document.getElementById('admin-login-box').classList.remove('hidden');
        }

        async function saveConfigs(e) {
            e.preventDefault();
            examConfigs['৩য়'] = document.getElementById('cfg-3').value || examConfigs['৩য়'];
            examConfigs['৬ষ্ঠ'] = document.getElementById('cfg-6').value || examConfigs['৬ষ্ঠ'];
            examConfigs['৯ম'] = document.getElementById('cfg-9').value || examConfigs['৯ম'];
            await saveSettingsToCloud();
            renderNoticeConfigs();
            alert('কনফিগারেশন ক্লাউডে আপডেট হয়েছে!');
        }

        async function addCommitteeMember(e) {
            e.preventDefault();
            committeeList.push({
                name: document.getElementById('cm-name').value,
                designation: document.getElementById('cm-designation').value,
                phone: document.getElementById('cm-phone').value
            });
            await saveSettingsToCloud();
            document.getElementById('cm-name').value = ''; document.getElementById('cm-designation').value = ''; document.getElementById('cm-phone').value = '';
            renderCommittee(); renderAdminCommittee();
        }

        async function removeCommittee(i) {
            committeeList.splice(i, 1);
            await saveSettingsToCloud();
            renderAdminCommittee();
            renderCommittee();
        }

        function renderAdminCommittee() {
            document.getElementById('admin-committee-list').innerHTML = committeeList.map((c, i) => `
                <div class="flex justify-between items-center p-2 bg-gray-50 border rounded-xl">
                    <span><strong>${c.name}</strong> (${c.designation}) - ${c.phone}</span>
                    <button onclick="removeCommittee(${i})" class="text-red-600 font-bold">মুছুন</button>
                </div>
            `).join('');
        }

        async function changeAdminCredentials(e) {
            e.preventDefault();
            adminAuth.user = document.getElementById('newAdminUser').value;
            adminAuth.pass = document.getElementById('newAdminPass').value;
            await saveSettingsToCloud();
            alert('সিকিউরিটি ও ক্রডেনশিয়াল আপডেট হয়েছে!');
        }

        function uploadBrandingFile(e, key) {
            const file = e.target.files[0];
            if(file) {
                const reader = new FileReader();
                reader.onload = async function(evt) {
                    if(key === 'panipur_logo') siteLogo = evt.target.result;
                    if(key === 'panipur_signature') siteSignature = evt.target.result;
                    await saveSettingsToCloud();
                    loadBranding(); 
                    alert('লোগো/স্বাক্ষর ক্লাউডে আপলোড হয়েছে!');
                };
                reader.readAsDataURL(file);
            }
        }

        function loadBranding() {
            if(siteLogo) {
                document.getElementById('site-logo').src = siteLogo;
                document.getElementById('site-logo').classList.remove('hidden');
                document.getElementById('site-logo-icon').classList.add('hidden');
                document.getElementById('admit-logo').src = siteLogo;
                document.getElementById('admit-logo').classList.remove('hidden');
            }
            if(siteSignature) {
                document.getElementById('admit-headmaster-sig').src = siteSignature;
                document.getElementById('admit-headmaster-sig').classList.remove('hidden');
            }
        }

        function loadAdminData() {
            document.getElementById('stat-total').innerText = applicants.length;
            document.getElementById('stat-3').innerText = applicants.filter(a => a.targetClass === '৩য়').length;
            document.getElementById('stat-69').innerText = applicants.filter(a => a.targetClass !== '৩য়').length;
            
            document.getElementById('cfg-3').value = examConfigs['৩য়'];
            document.getElementById('cfg-6').value = examConfigs['৬ষ্ঠ'];
            document.getElementById('cfg-9').value = examConfigs['৯ম'];
            renderAdminCommittee();
            filterApplicants();
        }

        function filterApplicants() {
            const selectedClass = document.getElementById('filter-class').value;
            const selectedGroup = document.getElementById('filter-group').value;

            let filtered = applicants;

            if(selectedClass !== 'All') {
                filtered = filtered.filter(a => a.targetClass === selectedClass);
            }

            if(selectedGroup !== 'All') {
                filtered = filtered.filter(a => a.targetClass === '৯ম' && a.group === selectedGroup);
            }

            document.getElementById('applicant-table-body').innerHTML = filtered.map((a) => {
                const originalIndex = applicants.findIndex(item => item.roll === a.roll);
                return `
                <tr class="border-b">
                    <td class="p-2 border font-bold">${a.roll}</td>
                    <td class="p-2 border">${a.name}</td>
                    <td class="p-2 border">${a.targetClass} ${a.group !== 'N/A' ? '('+a.group+')' : ''}</td>
                    <td class="p-2 border">${a.fatherName} <br><span class="text-gray-500 text-[10px]">NID: ${a.fatherNid}</span></td>
                    <td class="p-2 border">${a.fatherPhone}</td>
                    <td class="p-2 border font-bold ${a.paymentStatus === 'Paid' ? 'text-green-600' : 'text-orange-500'}">${a.paymentStatus}</td>
                    <td class="p-2 border">
                        <button onclick="viewStudentDetails(${originalIndex})" class="bg-blue-600 text-white px-2 py-1 rounded-lg text-xs">বিস্তারিত</button>
                    </td>
                </tr>
            `}).join('');
        }

        function exportToExcel() {
            if(applicants.length === 0) { alert('কোনো ডাটা নেই!'); return; }
            let csv = "\uFEFFরোল,নাম,শ্রেণি,বিভাগ,জন্ম নিবন্ধন,পিতার নাম,পিতার এনআইডি,মোবাইল,কোটা,পেমেন্ট স্ট্যাটাস\n";
            applicants.forEach(a => { 
                csv += `"${a.roll}","${a.name}","${a.targetClass}","${a.group}","${a.birthRegNo}","${a.fatherName}","${a.fatherNid}","${a.fatherPhone}","${a.quota}","${a.paymentStatus}"\n`; 
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "Full_Admission_Applicants_Report.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
