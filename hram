    <style>
        @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Hind Siliguri', sans-serif;
            background: linear-gradient(135deg, #f0fdf4 0%, #f3f4f6 100%);
        }
        .stylish-card {
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            border-top: 4px solid #065f46;
        }
        @media print {
            body * { visibility: hidden; }
            #printable-admit-card, #printable-admit-card * { visibility: visible; }
            #printable-admit-card {
                position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 20px; box-shadow: none !important; border: 2px solid #000 !important;
            }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-gray-800">

    <!-- Header Section -->
    <header class="bg-emerald-900 text-white shadow-lg border-b-4 border-yellow-500 no-print">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4 text-center md:text-left">
                <div class="bg-white p-2 rounded-full shadow-inner border border-yellow-400 w-16 h-16 flex items-center justify-center overflow-hidden">
                    <img id="site-logo" src="" alt="Logo" class="hidden w-full h-full object-contain">
                    <i id="site-logo-icon" data-lucide="school" class="w-10 h-10 text-emerald-900"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold tracking-wide">পানিপুর জেলা স্কুল</h1>
                    <p class="text-xs md:text-sm text-yellow-300">একটি ঐতিহ্যবাহী মনতেশ্বরী শিক্ষা প্রতিষ্ঠান</p>
                    <p class="text-xs text-emerald-200">হাটকালুপাড়া মহাসড়ক, পানিপুর | হেল্পলাইন: <span id="display-school-phone">০১৭০০-০০০০০০</span></p>
                </div>
            </div>
            <nav class="flex flex-wrap gap-2 justify-center">
                <button onclick="switchTab('notice')" id="nav-notice" class="px-3 py-2 text-sm font-semibold rounded-lg bg-yellow-500 text-emerald-950 transition">নোটিশ ও আসন</button>
                <button onclick="switchTab('apply')" id="nav-apply" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">ভর্তি আবেদন</button>
                <button onclick="switchTab('payment')" id="nav-payment" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">পেমেন্ট গেটওয়ে</button>
                <button onclick="switchTab('admit')" id="nav-admit" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">এডমিট কার্ড</button>
                <button onclick="switchTab('admin')" id="nav-admin" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">এডমিন প্যানেল</button>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto w-full p-4 md:p-6 flex-grow">

        <!-- TAB 1: Notice, Seats & Committee -->
        <section id="tab-notice" class="space-y-6">
            <div class="stylish-card p-6 bg-gradient-to-r from-emerald-800 to-teal-800 text-white">
                <h2 class="text-xl md:text-2xl font-bold mb-2">শিক্ষাবর্ষ ২০২৬ - ভর্তি বিজ্ঞপ্তি (৩য়, ৬ষ্ঠ ও ৯ম শ্রেণি)</h2>
                <p class="text-sm text-emerald-100">পানিপুর জেলা স্কুলে মেধা যাচাই পরীক্ষার মাধ্যমে শিক্ষার্থী ভর্তি করা হবে। অনলাইনে নির্ভুলভাবে আবেদন ফরম পূরণ করার অনুরোধ করা হলো।</p>
            </div>

            <div class="stylish-card p-6">
                <h3 class="text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2">
                    <i data-lucide="info" class="w-5 h-5"></i> শ্রেণিভিত্তিক আসন সংখ্যা ও পরীক্ষার সময়সূচি
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="display-configs-container"></div>
            </div>

            <div class="stylish-card p-6">
                <h3 class="text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2">
                    <i data-lucide="users" class="w-5 h-5"></i> ভর্তি কমিটি পরিচিতি
                </h3>
                <div id="committee-cards-container" class="grid grid-cols-1 md:grid-cols-3 gap-4"></div>
            </div>

            <div class="text-center">
                <button onclick="switchTab('apply')" class="bg-yellow-500 hover:bg-yellow-400 text-emerald-950 font-bold px-8 py-3 rounded-xl shadow-lg text-base transition">
                    অনলাইন আবেদন ফরম পূরণে এগিয়ে যান ➔
                </button>
            </div>
        </section>

        <!-- TAB 2: Full Detailed Admission Form Page -->
        <section id="tab-apply" class="hidden stylish-card p-6">
            <h3 class="text-2xl font-bold text-emerald-900 mb-6 border-b pb-2 flex items-center gap-2">
                <i data-lucide="file-text" class="w-6 h-6"></i> পূর্ণাঙ্গ ভর্তি আবেদন ফরম
            </h3>

            <form id="admission-form" onsubmit="handleFormSubmit(event)" class="space-y-6">
                <!-- Class Selection -->
                <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-200">
                    <label class="block font-bold text-emerald-900 mb-2">আবেদনকৃত শ্রেণি *</label>
                    <div class="grid grid-cols-3 gap-4">
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded-lg border hover:border-emerald-500">
                            <input type="radio" name="targetClass" value="৩য়" required onchange="toggleGroupSelection()"> ৩য় শ্রেণি
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded-lg border hover:border-emerald-500">
                            <input type="radio" name="targetClass" value="৬ষ্ঠ" onchange="toggleGroupSelection()"> ৬ষ্ঠ শ্রেণি
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded-lg border hover:border-emerald-500">
                            <input type="radio" name="targetClass" value="৯ম" onchange="toggleGroupSelection()"> ৯ম শ্রেণি
                        </label>
                    </div>

                    <div id="group-selection" class="hidden mt-4 pt-3 border-t border-emerald-200">
                        <label class="block font-bold text-emerald-900 mb-2">বিভাগ (৯ম শ্রেণির জন্য) *</label>
                        <div class="grid grid-cols-3 gap-4">
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 rounded-lg border">
                                <input type="radio" name="studentGroup" value="বিজ্ঞান"> বিজ্ঞান
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 rounded-lg border">
                                <input type="radio" name="studentGroup" value="মানবিক"> মানবিক
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 rounded-lg border">
                                <input type="radio" name="studentGroup" value="ব্যবসায় শিক্ষা"> ব্যবসায় শিক্ষা
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Student Personal Info -->
                <div class="bg-gray-50 p-4 rounded-xl border">
                    <h4 class="font-bold text-emerald-900 mb-3 border-b pb-1">১. শিক্ষার্থীর ব্যক্তিগত তথ্য ও ছবি</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">শিক্ষার্থীর পূর্ণ নাম (বাংলায়) *</label>
                            <input type="text" id="studentName" required class="w-full p-2.5 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পাসপোর্ট সাইজ ছবি আপলোড *</label>
                            <input type="file" id="studentPhoto" accept="image/*" required class="w-full p-2 border rounded-xl text-sm bg-white">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">জন্ম নিবন্ধন নম্বর (১৭ ডিজিট) *</label>
                            <input type="text" id="birthRegNo" required class="w-full p-2.5 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">জন্ম তারিখ *</label>
                            <input type="date" id="dob" required class="w-full p-2.5 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">লিঙ্গ *</label>
                            <select id="gender" required class="w-full p-2.5 border rounded-xl outline-none">
                                <option value="">নির্বাচন করুন</option>
                                <option value="ছাত্র">ছাত্র</option>
                                <option value="ছাত্রী">ছাত্রী</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">ধর্ম *</label>
                            <select id="religion" required class="w-full p-2.5 border rounded-xl outline-none">
                                <option value="ইসলাম">ইসলাম</option>
                                <option value="হিন্দু">হিন্দু</option>
                                <option value="বৌদ্ধ">বৌদ্ধ</option>
                                <option value="খ্রিষ্টান">খ্রিষ্টান</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Parents Info -->
                <div class="bg-gray-50 p-4 rounded-xl border">
                    <h4 class="font-bold text-emerald-900 mb-3 border-b pb-1">২. পিতা ও মাতার তথ্য</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পিতার নাম *</label>
                            <input type="text" id="fatherName" required class="w-full p-2 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পিতার মোবাইল নম্বর *</label>
                            <input type="tel" id="fatherPhone" required pattern="[0-9]{11}" class="w-full p-2 border rounded-xl outline-none" placeholder="017xxxxxxxx">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পিতার এনআইডি নম্বর *</label>
                            <input type="text" id="fatherNid" required class="w-full p-2 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পিতার পেশা *</label>
                            <input type="text" id="fatherOccupation" required class="w-full p-2 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">মাতার নাম *</label>
                            <input type="text" id="motherName" required class="w-full p-2 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">মাতার এনআইডি নম্বর</label>
                            <input type="text" id="motherNid" class="w-full p-2 border rounded-xl outline-none">
                        </div>
                    </div>
                </div>

                <!-- Address & Academic Info -->
                <div class="bg-gray-50 p-4 rounded-xl border">
                    <h4 class="font-bold text-emerald-900 mb-3 border-b pb-1">৩. ঠিকানা ও শিক্ষাগত তথ্য</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">বর্তমান ঠিকানা *</label>
                            <textarea id="presentAddress" required rows="2" class="w-full p-2 border rounded-xl outline-none"></textarea>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পূর্ববর্তী প্রতিষ্ঠানের নাম *</label>
                            <input type="text" id="prevSchool" required class="w-full p-2 border rounded-xl outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">পূর্ববর্তী শ্রেণির ফলাফল *</label>
                            <input type="text" id="prevResult" required class="w-full p-2 border rounded-xl outline-none" placeholder="GPA বা স্থান">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">বিশেষ কোটা</label>
                            <select id="quota" class="w-full p-2 border rounded-xl outline-none">
                                <option value="সাধারণ">সাধারণ (কোন কোটা নেই)</option>
                                <option value="মুক্তিযোদ্ধা কোটা">মুক্তিযোদ্ধা কোটা</option>
                                <option value="প্রতিবন্ধী কোটা">প্রতিবন্ধী কোটা</option>
                                <option value="ভাই-বোন কোটা">ভাই-বোন কোটা</option>
                                <option value="সরকারি প্রাথমিক বিদ্যালয় কোটা">সরকারি প্রাথমিক বিদ্যালয় কোটা</option>
                            </select>
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-3 rounded-xl shadow-lg text-lg transition flex justify-center items-center gap-2">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i> তথ্য সেভ করুন ও পেমেন্ট গেটওয়েতে যান
                </button>
            </form>
        </section>

        <!-- TAB 3: Payment Gateway Page -->
        <section id="tab-payment" class="hidden stylish-card p-6 max-w-xl mx-auto">
            <h3 class="text-xl font-bold text-emerald-900 mb-4 flex items-center gap-2 border-b pb-2">
                <i data-lucide="credit-card" class="w-6 h-6"></i> ই-পেমেন্ট গেটওয়ে (ফি: ২৫০ টাকা)
            </h3>
            
            <form onsubmit="handlePaymentSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold mb-1">আপনার রোল বা পিতার মোবাইল নম্বর দিন *</label>
                    <input type="text" id="pay-identifier" required class="w-full p-2.5 border rounded-xl outline-none">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">পেমেন্ট মাধ্যম *</label>
                    <div class="flex gap-4 mt-1">
                        <label class="flex items-center gap-2 cursor-pointer font-bold text-pink-600 bg-pink-50 p-3 rounded-xl border border-pink-200 flex-1 justify-center">
                            <input type="radio" name="gateway" value="bkash" checked> বিকাশ (bKash)
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer font-bold text-orange-600 bg-orange-50 p-3 rounded-xl border border-orange-200 flex-1 justify-center">
                            <input type="radio" name="gateway" value="nagad"> নগদ (Nagad)
                        </label>
                    </div>
                </div>

                <div class="bg-gray-50 p-3 rounded-xl text-xs text-gray-600">
                    <p>মার্চেন্ট নম্বর: <strong>01700000000</strong></p>
                    <p>টাকা পাঠিয়ে ট্রানজেকশন আইডি (TrxID) নিচে লিখুন।</p>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">ট্রানজেকশন আইডি (TrxID) দিন *</label>
                    <input type="text" id="pay-trxid" required class="w-full p-2.5 border rounded-xl uppercase outline-none" placeholder="যেমন: 9N74K...">
                </div>

                <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-400 text-emerald-950 font-bold py-3 rounded-xl shadow transition">
                    পেমেন্ট কনফার্ম করুন ও এডমিট ডাউনলোডে যান
                </button>
            </form>
        </section>

        <!-- TAB 4: Admit Card Page -->
        <section id="tab-admit" class="hidden space-y-6">
            <div class="stylish-card p-6 no-print max-w-xl mx-auto">
                <h3 class="text-xl font-bold text-emerald-900 mb-4 flex items-center gap-2">
                    <i data-lucide="search" class="w-5 h-5"></i> প্রবেশপত্র (Admit Card) ডাউনলোড
                </h3>
                <div class="flex gap-3">
                    <input type="text" id="searchRoll" placeholder="রোল নম্বর বা মোবাইল নম্বর" class="flex-grow p-2.5 border rounded-xl outline-none">
                    <button onclick="searchAdmitCard()" class="bg-emerald-800 text-white px-6 py-2.5 rounded-xl font-bold hover:bg-emerald-900 transition">খুঁজুন</button>
                </div>
            </div>

            <div id="admit-card-container" class="hidden">
                <div id="printable-admit-card" class="bg-white p-8 rounded-xl border-2 border-emerald-900 shadow-xl max-w-2xl mx-auto relative">
                    <div class="text-center border-b-2 border-emerald-800 pb-4 mb-6 relative">
                        <div class="absolute left-0 top-0 w-16 h-16 flex items-center justify-center">
                            <img id="admit-logo" src="" alt="" class="hidden w-full h-full object-contain">
                        </div>
                        <h2 class="text-2xl font-bold text-emerald-900">পানিপুর জেলা স্কুল</h2>
                        <p class="text-xs text-gray-600">হাটকালুপাড়া মহাসড়ক, পানিপুর</p>
                        <span class="inline-block bg-emerald-900 text-white text-sm font-bold px-4 py-1 rounded-full mt-2">প্রবেশপত্র (Admit Card) - ২০২৬</span>
                    </div>

                    <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
                        <p><strong>রোল নম্বর:</strong> <span id="ac-roll" class="font-bold text-emerald-800 text-base"></span></p>
                        <p><strong>শ্রেণি ও বিভাগ:</strong> <span id="ac-class" class="font-bold"></span> <span id="ac-group" class="font-bold"></span></p>
                        <p><strong>শিক্ষার্থীর নাম:</strong> <span id="ac-name"></span></p>
