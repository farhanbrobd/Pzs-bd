<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>পানিপুর জেলা স্কুল - অনলাইন ভর্তি ও প্রবেশপত্র পোর্টাল</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kalpurush&family=Noto+Serif+Bengali:wght@400;600;700&display=swap');
        body {
            font-family: 'Noto Serif Bengali', 'Kalpurush', sans-serif;
            background-color: #f3f4f6;
        }
        @media print {
            body * { visibility: hidden; }
            #printable-admit-card, #printable-admit-card * { visibility: visible; }
            #printable-admit-card {
                position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 20px; box-shadow: none !important; border: 2px solid #000 !important;
            }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-gray-800">

    <!-- Header Section -->
    <header class="bg-emerald-900 text-white shadow-lg border-b-4 border-yellow-500 no-print">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4 text-center md:text-left">
                <div class="bg-white p-2 rounded-full shadow-inner border border-yellow-400 w-16 h-16 flex items-center justify-center overflow-hidden">
                    <img id="site-logo" src="" alt="Logo" class="hidden w-full h-full object-contain">
                    <i id="site-logo-icon" data-lucide="school" class="w-10 h-10 text-emerald-900"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold tracking-wide">পানিপুর জেলা স্কুল</h1>
                    <p class="text-xs md:text-sm text-yellow-300">একটি ঐতিহ্যবাহী মন্টেসরি শিক্ষা প্রতিষ্ঠান</p>
                    <p class="text-xs text-emerald-200">হাটকালুপাড়া মহাসড়ক, পানিপুর | হেল্পলাইন: <span id="display-school-phone">০১৭০০-০০০০০০</span></p>
                </div>
            </div>
            <nav class="flex flex-wrap gap-2 justify-center">
                <button onclick="switchTab('notice')" id="nav-notice" class="px-3 py-2 text-sm font-semibold rounded-lg bg-yellow-500 text-emerald-950 transition">নোটিশ ও আসন</button>
                <button onclick="switchTab('apply')" id="nav-apply" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">ভর্তি আবেদন</button>
                <button onclick="switchTab('payment')" id="nav-payment" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">পেমেন্ট গেটওয়ে</button>
                <button onclick="switchTab('admit')" id="nav-admit" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">এডমিট কার্ড</button>
                <button onclick="switchTab('admin')" id="nav-admin" class="px-3 py-2 text-sm font-semibold rounded-lg bg-emerald-800 hover:bg-emerald-700 transition">এডমিন প্যানেল</button>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto w-full p-4 md:p-6 flex-grow">

        <!-- TAB 1: Notice, Seats & Committee (Home) -->
        <section id="tab-notice" class="space-y-6">
            <div class="bg-gradient-to-r from-emerald-800 to-teal-800 text-white p-6 rounded-xl shadow-md">
                <h2 class="text-xl md:text-2xl font-bold mb-2">শিক্ষাবর্ষ ২০২৬ - ভর্তি বিজ্ঞপ্তি</h2>
                <p class="text-sm text-emerald-100">পানিপুর জেলা স্কুলের ৩য়, ৬ষ্ঠ ও ৯ম শ্রেণিতে শিক্ষার্থী ভর্তির জন্য অনলাইনে আবেদন আহ্বান করা হচ্ছে। নিচের তথ্যগুলো ভালোভাবে পড়ে আবেদন সম্পন্ন করুন।</p>
            </div>

            <!-- Seat Matrix & Exam Info Display -->
            <div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
                <h3 class="text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2">
                    <i data-lucide="info" class="w-5 h-5"></i> শ্রেণিভিত্তিক আসন সংখ্যা ও পরীক্ষার সময়সূচি
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="display-configs-container">
                    <!-- Dynamic filled by JS -->
                </div>
            </div>

            <!-- Committee Members Showcase -->
            <div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
                <h3 class="text-lg font-bold text-emerald-900 mb-4 flex items-center gap-2">
                    <i data-lucide="users" class="w-5 h-5"></i> ভর্তি কমিটি পরিচিতি
                </h3>
                <div id="committee-cards-container" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <p class="text-sm text-gray-500">কোনো কমিটি সদস্য যুক্ত করা হয়নি।</p>
                </div>
            </div>

            <div class="text-center">
                <button onclick="switchTab('apply')" class="bg-yellow-500 hover:bg-yellow-400 text-emerald-950 font-bold px-8 py-3 rounded-lg shadow-lg text-base transition">
                    অনলাইন আবেদন ফরম পূরণে এগিয়ে যান ➔
                </button>
            </div>
        </section>

        <!-- TAB 2: Admission Form Page -->
        <section id="tab-apply" class="hidden bg-white rounded-xl shadow-md p-6 border border-gray-200">
            <h3 class="text-2xl font-bold text-emerald-900 mb-6 border-b pb-2 flex items-center gap-2">
                <i data-lucide="file-text" class="w-6 h-6"></i> ভর্তি আবেদনের ফরম
            </h3>

            <form id="admission-form" onsubmit="handleFormSubmit(event)" class="space-y-6">
                <div class="bg-emerald-50 p-4 rounded-lg border border-emerald-200">
                    <label class="block font-bold text-emerald-900 mb-2">আবেদনকৃত শ্রেণি *</label>
                    <div class="grid grid-cols-3 gap-4">
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded border hover:border-emerald-500">
                            <input type="radio" name="targetClass" value="৩য়" required onchange="toggleGroupSelection()"> ৩য় শ্রেণি
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded border hover:border-emerald-500">
                            <input type="radio" name="targetClass" value="৬ষ্ঠ" onchange="toggleGroupSelection()"> ৬ষ্ঠ শ্রেণি
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded border hover:border-emerald-500">
                            <input type="radio" name="targetClass" value="৯ম" onchange="toggleGroupSelection()"> ৯ম শ্রেণি
                        </label>
                    </div>

                    <div id="group-selection" class="hidden mt-4 pt-3 border-t border-emerald-200">
                        <label class="block font-bold text-emerald-900 mb-2">বিভাগ (৯ম শ্রেণির জন্য) *</label>
                        <div class="grid grid-cols-3 gap-4">
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 rounded border">
                                <input type="radio" name="studentGroup" value="বিজ্ঞান"> বিজ্ঞান
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 rounded border">
                                <input type="radio" name="studentGroup" value="মানবিক"> মানবিক
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer bg-white p-2 rounded border">
                                <input type="radio" name="studentGroup" value="ব্যবসায় শিক্ষা"> ব্যবসায় শিক্ষা
                            </label>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">শিক্ষার্থীর পূর্ণ নাম *</label>
                        <input type="text" id="studentName" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="বাংলায় লিখুন">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">জন্ম নিবন্ধন সনদ নম্বর *</label>
                        <input type="text" id="birthRegNo" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="১৭ ডিজিটের সনদ নম্বর">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">পিতার নাম *</label>
                        <input type="text" id="fatherName" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">পিতার পেশা *</label>
                        <input type="text" id="fatherOccupation" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">মাতার নাম *</label>
                        <input type="text" id="motherName" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">মাতার পেশা *</label>
                        <input type="text" id="motherOccupation" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">পূর্ববর্তী প্রতিষ্ঠানের নাম *</label>
                        <input type="text" id="prevSchool" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">পূর্ববর্তী শ্রেণির ফলাফল *</label>
                        <input type="text" id="prevResult" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="যেমন: GPA 5.00 বা ১ম স্থান">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">অভিভাবকের মোবাইল নম্বর *</label>
                        <input type="tel" id="mobileNo" required pattern="[0-9]{11}" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="017xxxxxxxx">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">সম্পূর্ণ ঠিকানা *</label>
                        <textarea id="address" required rows="2" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none"></textarea>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-gray-700 mb-1">বিশেষ কোটা</label>
                    <select id="quota" class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                        <option value="সাধারণ">সাধারণ (কোন কোটা নেই)</option>
                        <option value="মুক্তিযোদ্ধা কোটা">মুক্তিযোদ্ধা কোটা</option>
                        <option value="ভাই-বোন কোটা">ভাই-বোন কোটা</option>
                        <option value="প্রাথমিক বিদ্যালয় কোটা">প্রাথমিক বিদ্যালয় কোটা</option>
                    </select>
                </div>

                <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-3 rounded-lg shadow-lg text-lg transition flex justify-center items-center gap-2">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i> তথ্য সেভ করে পেমেন্ট গেটওয়েতে যান
                </button>
            </form>
        </section>

        <!-- TAB 3: Payment Gateway Page -->
        <section id="tab-payment" class="hidden bg-white rounded-xl shadow-md p-6 border border-gray-200 max-w-xl mx-auto">
            <h3 class="text-xl font-bold text-emerald-900 mb-4 flex items-center gap-2 border-b pb-2">
                <i data-lucide="credit-card" class="w-6 h-6"></i> ই-পেমেন্ট গেটওয়ে (ফি: ২৫০ টাকা)
            </h3>
            
            <form onsubmit="handlePaymentSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold mb-1">আপনার আবেদনকৃত মোবাইল নম্বর অথবা রোল দিন *</label>
                    <input type="text" id="pay-identifier" required class="w-full p-2.5 border rounded-lg outline-none focus:ring-2 focus:ring-emerald-500" placeholder="মোবাইল নম্বর বা রোল">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">পেমেন্ট মাধ্যম নির্বাচন করুন *</label>
                    <div class="flex gap-4 mt-1">
                        <label class="flex items-center gap-2 cursor-pointer font-bold text-pink-600 bg-pink-50 p-3 rounded border border-pink-200 flex-1 justify-center">
                            <input type="radio" name="gateway" value="bkash" checked> বিকাশ (bKash)
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer font-bold text-orange-600 bg-orange-50 p-3 rounded border border-orange-200 flex-1 justify-center">
                            <input type="radio" name="gateway" value="nagad"> নগদ (Nagad)
                        </label>
                    </div>
                </div>

                <div class="bg-gray-50 p-3 rounded text-xs text-gray-600">
                    <p>মার्चেন্ট নম্বর: <strong>01700000000</strong> (Personal/Merchant)</p>
                    <p>রেফারেন্স বক্সে আপনার জন্ম নিবন্ধন বা নাম লিখে ২৫০ টাকা সেন্ড মানি বা ক্যাশ আউট করুন।</p>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">ট্রানজেকশন আইডি (TrxID) দিন *</label>
                    <input type="text" id="pay-trxid" required class="w-full p-2.5 border rounded-lg uppercase outline-none focus:ring-2 focus:ring-emerald-500" placeholder="যেমন: 9N74K... ">
                </div>

                <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-400 text-emerald-950 font-bold py-3 rounded-lg shadow transition">
                    পেমেন্ট কনফার্ম করুন ও টোকেন নিন
                </button>
            </form>
        </section>

        <!-- TAB 4: Admit Card Search & Print Page -->
        <section id="tab-admit" class="hidden space-y-6">
            <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200 no-print max-w-xl mx-auto">
                <h3 class="text-xl font-bold text-emerald-900 mb-4 flex items-center gap-2">
                    <i data-lucide="search" class="w-5 h-5"></i> প্রবেশপত্র (Admit Card) ডাউনলোড
                </h3>
                <div class="flex gap-3">
                    <input type="text" id="searchRoll" placeholder="রোল নম্বর বা মোবাইল নম্বর দিন" class="flex-grow p-2.5 border rounded-lg outline-none focus:ring-2 focus:ring-emerald-500">
                    <button onclick="searchAdmitCard()" class="bg-emerald-800 text-white px-6 py-2.5 rounded-lg font-bold hover:bg-emerald-900 transition">খুঁজুন</button>
                </div>
            </div>

            <!-- Printable Card Design -->
            <div id="admit-card-container" class="hidden">
                <div id="printable-admit-card" class="bg-white p-8 rounded-xl border-2 border-emerald-900 shadow-xl max-w-2xl mx-auto relative">
                    <div class="text-center border-b-2 border-emerald-800 pb-4 mb-6 relative">
                        <div class="absolute left-0 top-0 w-16 h-16 flex items-center justify-center">
                            <img id="admit-logo" src="" alt="" class="hidden w-full h-full object-contain">
                        </div>
                        <h2 class="text-2xl font-bold text-emerald-900">পানিপুর জেলা স্কুল</h2>
                        <p class="text-xs text-gray-600">হাটকালুপাড়া মহাসড়ক, পানিপুর</p>
                        <span class="inline-block bg-emerald-900 text-white text-sm font-bold px-4 py-1 rounded-full mt-2">প্রবেশপত্র (Admit Card) - ২০২৬</span>
                    </div>

                    <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
                        <p><strong>রোল নম্বর:</strong> <span id="ac-roll" class="font-bold text-emerald-800 text-base"></span></p>
                        <p><strong>শ্রেণি:</strong> <span id="ac-class" class="font-bold"></span></p>
                        <p><strong>বিভাগ:</strong> <span id="ac-group">প্রযোজ্য নয়</span></p>
                        <p><strong>শিক্ষার্থীর নাম:</strong> <span id="ac-name"></span></p>
                        <p><strong>পিতার নাম:</strong> <span id="ac-father"></span></p>
                        <p><strong>মাতার নাম:</strong> <span id="ac-mother"></span></p>
                        <p><strong>মোবাইল নম্বর:</strong> <span id="ac-mobile"></span></p>
                        <p><strong>পেমেন্ট স্ট্যাটাস:</strong> <span class="text-green-700 font-bold">যাচাইকৃত (Paid)</span></p>
                    </div>

                    <div class="mt-6 bg-emerald-50 p-4 rounded-lg border border-emerald-200">
                        <h4 class="font-bold text-emerald-900 text-sm mb-2 border-b pb-1">পরীক্ষার সময়সূচি:</h4>
                        <p class="text-xs"><strong>সময় ও তারিখ:</strong> <span id="ac-exam-info"></span></p>
                    </div>

                    <div class="mt-4 text-xs text-gray-600 space-y-1 border-t pt-3">
                        <p class="font-bold text-gray-700">নির্দেশাবলী:</p>
                        <div id="ac-instructions-display"></div>
                    </div>

                    <div class="mt-12 flex justify-between items-end text-xs pt-4 border-t border-dashed">
                        <div class="text-center">
                            <p class="border-t border-gray-400 px-4 pt-1">শিক্ষার্থীর স্বাক্ষর</p>
                        </div>
                        <div class="text-center flex flex-col items-center">
                            <div class="h-10 w-28 flex items-center justify-center mb-1">
                                <img id="admit-headmaster-sig" src="" alt="স্বাক্ষর" class="hidden max-h-full max-w-full object-contain">
                            </div>
                            <p class="font-bold">প্রধান শিক্ষক</p>
                            <p class="border-t border-gray-400 px-4 pt-1">পানিপুর জেলা স্কুল</p>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4 no-print">
                    <button onclick="window.print()" class="bg-yellow-500 hover:bg-yellow-400 text-emerald-950 font-bold px-6 py-2.5 rounded-lg shadow-md transition inline-flex items-center gap-2">
                        <i data-lucide="printer" class="w-5 h-5"></i> প্রিন্ট বা PDF হিসেবে সেভ করুন
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 5: Admin Panel (Multi-Tab) -->
        <section id="tab-admin" class="hidden">
            <!-- Login Box -->
            <div id="admin-login-box" class="bg-white rounded-xl shadow-md p-6 max-w-md mx-auto border border-gray-200 no-print">
                <h3 class="text-xl font-bold text-emerald-900 mb-4 text-center flex items-center justify-center gap-2">
                    <i data-lucide="lock" class="w-5 h-5"></i> এডমিন লগইন
                </h3>
                <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold mb-1">ইউজার আইডি</label>
                        <input type="text" id="adminUser" required class="w-full p-2 border rounded outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1">পাসওয়ার্ড</label>
                        <input type="password" id="adminPass" required class="w-full p-2 border rounded outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <button type="submit" class="w-full bg-emerald-800 text-white font-bold py-2 rounded hover:bg-emerald-900 transition">লগইন করুন</button>
                </form>
            </div>

            <!-- Admin Dashboard Content -->
            <div id="admin-dashboard" class="hidden space-y-6">
                <div class="bg-white p-4 rounded-xl shadow border flex flex-col md:flex-row justify-between items-center gap-4">
                    <h3 class="text-xl font-bold text-emerald-900">এডমিন কন্ট্রোল প্যানেল</h3>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <button onclick="switchAdminTab('overview')" id="atab-btn-overview" class="px-3 py-1.5 rounded font-bold bg-emerald-800 text-white">ড্যাশবোর্ড ও সিট</button>
                        <button onclick="switchAdminTab('applicants')" id="atab-btn-applicants" class="px-3 py-1.5 rounded font-bold bg-gray-100 text-gray-700">আবেদন তালিকা ও এক্সেল</button>
                        <button onclick="switchAdminTab('committee')" id="atab-btn-committee" class="px-3 py-1.5 rounded font-bold bg-gray-100 text-gray-700">কমিটি ম্যানেজমেন্ট</button>
                        <button onclick="switchAdminTab('settings')" id="atab-btn-settings" class="px-3 py-1.5 rounded font-bold bg-gray-100 text-gray-700">সিকিউরিটি ও সেটিংস</button>
                    </div>
                    <button onclick="adminLogout()" class="bg-red-600 text-white text-xs px-3 py-1.5 rounded font-bold">লগআউট</button>
                </div>

                <!-- Admin Tab 1: Seats & Config -->
                <div id="atab-overview" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
                        <div class="bg-white p-4 rounded-xl border shadow"><p class="text-sm text-gray-500">মোট আবেদন</p><p id="stat-total" class="text-3xl font-bold text-emerald-900">0</p></div>
                        <div class="bg-white p-4 rounded-xl border shadow"><p class="text-sm text-gray-500">৩য় শ্রেণি</p><p id="stat-3" class="text-3xl font-bold text-emerald-700">0</p></div>
                        <div class="bg-white p-4 rounded-xl border shadow"><p class="text-sm text-gray-500">৬ষ্ঠ ও ৯ম শ্রেণি</p><p id="stat-69" class="text-3xl font-bold text-emerald-700">0</p></div>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow border">
                        <h4 class="font-bold text-emerald-900 mb-4 border-b pb-2">শ্রেণিভিত্তিক আসন সংখ্যা ও পরীক্ষার সময়সূচি ইনপুট</h4>
                        <form onsubmit="saveConfigs(event)" class="space-y-4 text-sm">
                            <div>
                                <label class="block font-semibold mb-1">৩য় শ্রেণির তথ্য (যেমন: আসন: ১০০, তারিখ: ১৮ ডিসেম্বর)</label>
                                <input type="text" id="cfg-3" class="w-full p-2 border rounded">
                            </div>
                            <div>
                                <label class="block font-semibold mb-1">৬ষ্ঠ শ্রেণির তথ্য (যেমন: আসন: ১২০, তারিখ: ১৯ ডিসেম্বর)</label>
                                <input type="text" id="cfg-6" class="w-full p-2 border rounded">
                            </div>
                            <div>
                                <label class="block font-semibold mb-1">৯ম শ্রেণির তথ্য (যেমন: আসন: ১৫০, তারিখ: ২০ ডিসেম্বর)</label>
                                <input type="text" id="cfg-9" class="w-full p-2 border rounded">
                            </div>
                            <button type="submit" class="bg-emerald-800 text-white px-4 py-2 rounded font-bold">নোটিশে প্রকাশ করুন</button>
                        </form>
                    </div>
                </div>

                <!-- Admin Tab 2: Applicants & Excel -->
                <div id="atab-applicants" class="hidden bg-white p-6 rounded-xl shadow border overflow-x-auto">
                    <div class="flex justify-between items-center mb-4">
                        <h4 class="font-bold text-emerald-900">আবেদনকারীদের তালিকা ও পেমেন্ট ট্রানজেকশন</h4>
                        <button onclick="exportToExcel()" class="bg-green-700 text-white text-xs font-bold px-4 py-2 rounded">Excel (CSV) ডাউনলোড</button>
                    </div>
                    <table class="w-full text-left text-xs md:text-sm border-collapse">
                        <thead>
                            <tr class="bg-emerald-900 text-white">
                                <th class="p-2 border">রোল</th>
                                <th class="p-2 border">নাম</th>
                                <th class="p-2 border">শ্রেণি</th>
                                <th class="p-2 border">মোবাইল</th>
                                <th class="p-2 border">TrxID</th>
                                <th class="p-2 border">স্ট্যাটাস</th>
                            </tr>
                        </thead>
                        <tbody id="applicant-table-body"></tbody>
                    </table>
                </div>

                <!-- Admin Tab 3: Committee -->
                <div id="atab-committee" class="hidden bg-white p-6 rounded-xl shadow border">
                    <h4 class="font-bold text-emerald-900 mb-4 border-b pb-2">ভর্তি কমিটির সদস্য যোগ করুন (হোমপেজে দেখাবে)</h4>
                    <form onsubmit="addCommitteeMember(event)" class="grid grid-cols-1 md:grid-cols-4 gap-3 text-sm mb-4">
                        <input type="text" id="cm-name" placeholder="নাম" required class="p-2 border rounded">
                        <input type="text" id="cm-designation" placeholder="পদবি" required class="p-2 border rounded">
                        <input type="text" id="cm-phone" placeholder="মোবাইল নম্বর" required class="p-2 border rounded">
                        <button type="submit" class="bg-emerald-800 text-white p-2 rounded font-bold">যোগ করুন</button>
                    </form>
                    <div id="admin-committee-list" class="space-y-2 text-xs"></div>
                </div>

                <!-- Admin Tab 4: Settings & Security -->
                <div id="atab-settings" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-xl shadow border border-red-200">
                        <h4 class="font-bold text-red-900 mb-3 border-b pb-2">এডমিন আইডি ও পাসওয়ার্ড পরিবর্তন</h4>
                        <form onsubmit="changeAdminCredentials(event)" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                            <input type="text" id="newAdminUser" required class="p-2 border rounded" placeholder="নতুন আইডি">
                            <input type="password" id="newAdminPass" required class="p-2 border rounded" placeholder="নতুন পাসওয়ার্ড">
                            <button type="submit" class="bg-red-700 text-white p-2 rounded font-bold">আপডেট করুন</button>
                        </form>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow border">
                        <h4 class="font-bold text-emerald-900 mb-4 border-b pb-2">লোগো ও প্রধান শিক্ষকের স্বাক্ষর আপলোড</h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                            <div>
                                <label class="block font-semibold mb-1">লোগো ছবি</label>
                                <input type="file" accept="image/*" onchange="uploadFile(event, 'panipur_logo')" class="w-full p-1 border rounded text-xs">
                            </div>
                            <div>
                                <label class="block font-semibold mb-1">প্রধান শিক্ষকের স্বাক্ষর ছবি</label>
                                <input type="file" accept="image/*" onchange="uploadFile(event, 'panipur_signature')" class="w-full p-1 border rounded text-xs">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-emerald-950 text-emerald-300 text-center py-4 text-xs no-print border-t border-emerald-800">
        <p>© ২০২৬ পানিপুর জেলা স্কুল | মন্টেসরি শিক্ষা প্রতিষ্ঠান | সর্বস্বত্ব সংরক্ষিত</p>
    </footer>

    <!-- JavaScript Engine -->
    <script>
        lucide.createIcons();

        let applicants = JSON.parse(localStorage.getItem('panipur_applicants')) || [];
        let examConfigs = JSON.parse(localStorage.getItem('panipur_configs')) || {
            '৩য়': 'আসন: ১০০ টি | পরীক্ষা: ১৮ ডিসেম্বর ২০২৬, সকাল ১০টা',
            '৬ষ্ঠ': 'আসন: ১২০ টি | পরীক্ষা: ১৯ ডিসেম্বর ২০২৬, সকাল ১০টা',
            '৯ম': 'আসন: ১৫০ টি | পরীক্ষা: ২০ ডিসেম্বর ২০২৬, সকাল ১০টা'
        };
        let adminAuth = JSON.parse(localStorage.getItem('panipur_admin')) || { user: 'admin', pass: 'panipur2026' };
        let committeeList = JSON.parse(localStorage.getItem('panipur_committee')) || [];
        let schoolPhone = localStorage.getItem('panipur_phone') || '০১৭০০-০০০০০০';

        window.onload = function() {
            loadBranding();
            renderNoticeConfigs();
            renderCommittee();
        };

        function switchTab(tabName) {
            ['notice', 'apply', 'payment', 'admit', 'admin'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                const btn = document.getElementById(`nav-${t}`);
                if(btn) {
                    btn.classList.remove('bg-yellow-500', 'text-emerald-950');
                    btn.classList.add('bg-emerald-800');
                }
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`nav-${tabName}`);
            if(activeBtn) {
                activeBtn.classList.add('bg-yellow-500', 'text-emerald-950');
                activeBtn.classList.remove('bg-emerald-800');
            }
        }

        function switchAdminTab(atab) {
            ['overview', 'applicants', 'committee', 'settings'].forEach(t => {
                document.getElementById(`atab-${t}`).classList.add('hidden');
                document.getElementById(`atab-btn-${t}`).classList.remove('bg-emerald-800', 'text-white');
                document.getElementById(`atab-btn-${t}`).classList.add('bg-gray-100', 'text-gray-700');
            });
            document.getElementById(`atab-${atab}`).classList.remove('hidden');
            document.getElementById(`atab-btn-${atab}`).classList.remove('bg-gray-100', 'text-gray-700');
            document.getElementById(`atab-btn-${atab}`).classList.add('bg-emerald-800', 'text-white');
        }

        function toggleGroupSelection() {
            const cls = document.querySelector('input[name="targetClass"]:checked')?.value;
            document.getElementById('group-selection').classList.toggle('hidden', cls !== '৯ম');
        }

        // Step 1: Form Submit -> Redirect to Payment
        function handleFormSubmit(e) {
            e.preventDefault();
            const targetClass = document.querySelector('input[name="targetClass"]:checked').value;
            const group = targetClass === '৯ম' ? (document.querySelector('input[name="studentGroup"]:checked')?.value || 'সাধারণ') : 'N/A';
            const newRoll = targetClass.charAt(0) + Math.floor(1000 + Math.random() * 9000);
            
            const applicantData = {
                roll: newRoll, targetClass, group,
                name: document.getElementById('studentName').value,
                birthRegNo: document.getElementById('birthRegNo').value,
                fatherName: document.getElementById('fatherName').value,
                fatherOccupation: document.getElementById('fatherOccupation').value,
                motherName: document.getElementById('motherName').value,
                motherOccupation: document.getElementById('motherOccupation').value,
                prevSchool: document.getElementById('prevSchool').value,
                prevResult: document.getElementById('prevResult').value,
                mobile: document.getElementById('mobileNo').value,
                address: document.getElementById('address').value,
                quota: document.getElementById('quota').value,
                paymentStatus: 'Pending',
                trxId: ''
            };

            applicants.push(applicantData);
            localStorage.setItem('panipur_applicants', JSON.stringify(applicants));
            alert(`প্রাথমিক তথ্য সংরক্ষিত হয়েছে!\nআপনার সাময়িক রোল/আইডি: ${newRoll}\nএখন পেমেন্ট গেটওয়ে পেজে গিয়ে ২৫০ টাকা ফি পরিশোধ করুন।`);
            
            document.getElementById('admission-form').reset();
            switchTab('payment');
            document.getElementById('pay-identifier').value = newRoll;
        }

        // Step 2: Payment Submit -> Confirm & Allow Admit Card
        function handlePaymentSubmit(e) {
            e.preventDefault();
            const identifier = document.getElementById('pay-identifier').value.trim();
            const trxId = document.getElementById('pay-trxid').value.trim();

            const user = applicants.find(a => a.roll === identifier || a.mobile === identifier);
            if(user) {
                user.paymentStatus = 'Paid';
                user.trxId = trxId;
                localStorage.setItem('panipur_applicants', JSON.stringify(applicants));
                alert('পেমেন্ট সফলভাবে যাচাই হয়েছে! এখন আপনি এডমিট কার্ড ডাউনলোড করতে পারবেন।');
                switchTab('admit');
                document.getElementById('searchRoll').value = user.roll;
                searchAdmitCard();
            } else {
                alert('আপনার দেওয়া রোল বা মোবাইল নম্বর দিয়ে কোনো আবেদন পাওয়া যায়নি!');
            }
        }

        // Step 3: Search & Download Admit Card
        function searchAdmitCard() {
            const query = document.getElementById('searchRoll').value.trim();
            const result = applicants.find(a => (a.roll === query || a.mobile === query) && a.paymentStatus === 'Paid');

            if(result) {
                document.getElementById('ac-roll').innerText = result.roll;
                document.getElementById('ac-class').innerText = result.targetClass;
                document.getElementById('ac-group').innerText = result.group;
                document.getElementById('ac-name').innerText = result.name;
                document.getElementById('ac-father').innerText = result.fatherName;
                document.getElementById('ac-mother').innerText = result.motherName;
                document.getElementById('ac-mobile').innerText = result.mobile;
                document.getElementById('ac-exam-info').innerText = examConfigs[result.targetClass] || 'শীঘ্রই জানানো হবে';
                document.getElementById('ac-instructions-display').innerHTML = '<p>১. পরীক্ষার ৩০ মিনিট পূর্বে কেন্দ্রে উপস্থিত হতে হবে।<br>২. প্রবেশপত্রটি সাথে আনা বাধ্যতামূলক।</p>';
                document.getElementById('admit-card-container').classList.remove('hidden');
            } else {
                alert('পেমেন্ট সম্পন্ন হয়নি অথবা সঠিক তথ্য পাওয়া যায়নি!');
                document.getElementById('admit-card-container').classList.add('hidden');
            }
        }

        // Render Notice & Seats
        function renderNoticeConfigs() {
            const container = document.getElementById('display-configs-container');
            container.innerHTML = Object.keys(examConfigs).map(cls => `
                <div class="bg-emerald-50 p-4 rounded-lg border border-emerald-200">
                    <h4 class="font-bold text-emerald-900 text-base mb-1">${cls} শ্রেণি</h4>
                    <p class="text-xs text-gray-700">${examConfigs[cls]}</p>
                </div>
            `).join('');
        }

        // Render Committee
        function renderCommittee() {
            const container = document.getElementById('committee-cards-container');
            if(committeeList.length === 0) {
                container.innerHTML = '<p class="text-sm text-gray-500">কোনো কমিটি সদস্য যুক্ত করা হয়নি।</p>';
                return;
            }
            container.innerHTML = committeeList.map(c => `
                <div class="bg-gray-50 p-3 rounded-lg border text-center">
                    <p class="font-bold text-emerald-900">${c.name}</p>
                    <p class="text-xs text-gray-600">${c.designation}</p>
                    <p class="text-xs text-emerald-700 font-bold mt-1">📞 ${c.phone}</p>
                </div>
            `).join('');
        }

        // Admin Auth & Functions
        function handleAdminLogin(e) {
            e.preventDefault();
            if(document.getElementById('adminUser').value === adminAuth.user && document.getElementById('adminPass').value === adminAuth.pass) {
                document.getElementById('admin-login-box').classList.add('hidden');
                document.getElementById('admin-dashboard').classList.remove('hidden');
                loadAdminData();
            } else {
                alert('ভুল পাসওয়ার্ড বা ইউজার আইডি!');
            }
        }
        function adminLogout() {
            document.getElementById('admin-dashboard').classList.add('hidden');
            document.getElementById('admin-login-box').classList.remove('hidden');
        }

        function saveConfigs(e) {
            e.preventDefault();
            examConfigs['৩য়'] = document.getElementById('cfg-3').value || examConfigs['৩য়'];
            examConfigs['৬ষ্ঠ'] = document.getElementById('cfg-6').value || examConfigs['৬ষ্ঠ'];
            examConfigs['৯ম'] = document.getElementById('cfg-9').value || examConfigs['৯ম'];
            localStorage.setItem('panipur_configs', JSON.stringify(examConfigs));
            renderNoticeConfigs();
            alert('আসন ও সময়সূচি সফলভাবে আপডেট হয়েছে!');
        }

        function addCommitteeMember(e) {
            e.preventDefault();
            committeeList.push({
                name: document.getElementById('cm-name').value,
                designation: document.getElementById('cm-designation').value,
                phone: document.getElementById('cm-phone').value
            });
            localStorage.setItem('panipur_committee', JSON.stringify(committeeList));
            document.getElementById('cm-name').value = '';
            document.getElementById('cm-designation').value = '';
            document.getElementById('cm-phone').value = '';
            renderCommittee();
            renderAdminCommittee();
        }

        function renderAdminCommittee() {
            document.getElementById('admin-committee-list').innerHTML = committeeList.map((c, i) => `
                <div class="flex justify-between items-center p-2 bg-gray-50 border rounded">
                    <span><strong>${c.name}</strong> (${c.designation}) - ${c.phone}</span>
                    <button onclick="committeeList.splice(${i},1);localStorage.setItem('panipur_committee',JSON.stringify(committeeList));renderAdminCommittee();renderCommittee();" class="text-red-600 font-bold">মুছুন</button>
                </div>
            `).join('');
        }

        function changeAdminCredentials(e) {
            e.preventDefault();
            adminAuth.user = document.getElementById('newAdminUser').value;
            adminAuth.pass = document.getElementById('newAdminPass').value;
            localStorage.setItem('panipur_admin', JSON.stringify(adminAuth));
            alert('এডমিন সিকিউরিটি আপডেট হয়েছে!');
        }

        function uploadFile(e, key) {
            const file = e.target.files[0];
            if(file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    localStorage.setItem(key, evt.target.result);
                    loadBranding();
                    alert('সফলভাবে আপলোড হয়েছে!');
                };
                reader.readAsDataURL(file);
            }
        }

        function loadBranding() {
            const logo = localStorage.getItem('panipur_logo');
            if(logo) {
                document.getElementById('site-logo').src = logo;
                document.getElementById('site-logo').classList.remove('hidden');
                document.getElementById('site-logo-icon').classList.add('hidden');
                document.getElementById('admit-logo').src = logo;
                document.getElementById('admit-logo').classList.remove('hidden');
            }
            const sig = localStorage.getItem('panipur_signature');
            if(sig) {
                document.getElementById('admit-headmaster-sig').src = sig;
                document.getElementById('admit-headmaster-sig').classList.remove('hidden');
            }
        }

        function loadAdminData() {
            document.getElementById('stat-total').innerText = applicants.length;
            document.getElementById('stat-3').innerText = applicants.filter(a => a.targetClass === '৩য়').length;
            document.getElementById('stat-69').innerText = applicants.filter(a => a.targetClass !== '৩য়').length;
            
            document.getElementById('cfg-3').value = examConfigs['৩য়'];
            document.getElementById('cfg-6').value = examConfigs['৬ষ্ঠ'];
            document.getElementById('cfg-9').value = examConfigs['৯ম'];
            renderAdminCommittee();

            document.getElementById('applicant-table-body').innerHTML = applicants.map(a => `
                <tr class="border-b">
                    <td class="p-2 border font-bold">${a.roll}</td>
                    <td class="p-2 border">${a.name}</td>
                    <td class="p-2 border">${a.targetClass}</td>
                    <td class="p-2 border">${a.mobile}</td>
                    <td class="p-2 border">${a.trxId || 'N/A'}</td>
                    <td class="p-2 border font-bold ${a.paymentStatus === 'Paid' ? 'text-green-600' : 'text-orange-500'}">${a.paymentStatus}</td>
                </tr>
            `).join('');
        }

        function exportToExcel() {
            if(applicants.length === 0) { alert('কোনো ডাটা নেই!'); return; }
            let csv = "\uFEFFরোল,নাম,শ্রেণি,মোবাইল,TrxID,পেমেন্ট স্ট্যাটাস\n";
            applicants.forEach(a => { csv += `"${a.roll}","${a.name}","${a.targetClass}","${a.mobile}","${a.trxId}","${a.paymentStatus}"\n`; });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "Applicants_Report.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
